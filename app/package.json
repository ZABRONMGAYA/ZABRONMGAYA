{
  "name": "multicam-sync",
  "productName": "Multicam Sync",
  "version": "0.1.0",
  "description": "Automatic synchronisation of multicamera video and external audio",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zustand": "5.0.15"
  }
}
